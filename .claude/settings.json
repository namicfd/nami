{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh search issues:*)",
      "Bash(gh api repos/{owner}/{repo}/issues:*)",
      "Bash(gh api repos/namicfd/nami/issues:*)",
      "Bash(gh api /repos/namicfd/nami/issues:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && NAMI_SESSION_PATH=\"$PATH\" PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook post-edit",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook stop",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
