{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(/Cargo.toml)",
      "Edit(/crates/*/Cargo.toml)",
      "Edit(/Cargo.lock)",
      "Edit(/deny.toml)",
      "Edit(/clippy.toml)",
      "Edit(/rustfmt.toml)",
      "Edit(/rust-toolchain.toml)",
      "Edit(/.cargo/**)",
      "Edit(/.config/**)",
      "Edit(/xtask/**)",
      "Edit(/lints/**)",
      "Edit(/justfile)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/design/**)",
      "Edit(/docs/TIGER_STYLE.md)",
      "Edit(/crates/nami-oracle/**)",
      "Edit(/tools/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook post-edit",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook stop",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
