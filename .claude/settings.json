{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook post-edit",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook stop",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
