{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh search issues:*)",
      "Bash(gh api repos/{owner}/{repo}/issues:*)",
      "Bash(gh api repos/namicfd/nami/issues:*)",
      "Bash(gh api /repos/namicfd/nami/issues:*)"
    ]
  },
  "env": {
    "GIT_AUTHOR_NAME": "nami-agent[bot]",
    "GIT_AUTHOR_EMAIL": "360897210+nami-agent[bot]@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "nami-agent[bot]",
    "GIT_COMMITTER_EMAIL": "360897210+nami-agent[bot]@users.noreply.github.com",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_CONFIG_COUNT": "3",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": "",
    "GIT_CONFIG_KEY_1": "credential.helper",
    "GIT_CONFIG_VALUE_1": "!\"$(git rev-parse --show-toplevel)/xtask/agent-token.sh\" git-credential",
    "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_2": "git@github.com:"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && NAMI_SESSION_PATH=\"$PATH\" PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook post-edit",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook stop",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.cargo/bin:$PATH\" cargo xtask hook stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
