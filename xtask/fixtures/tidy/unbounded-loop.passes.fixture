// path: crates/solver/src/example.rs
//! Loops with a fixed upper bound. `take` and `zip` bound a range or an iterator without an end.

/// Upper bound on time steps.
const STEPS_MAX: u32 = 8;

fn run(cells: &[f64]) {
    for _step in 0..STEPS_MAX {}
    for _step in 0..=STEPS_MAX {}
    for _step in (0_u32..).take(3) {}
    for (_position, _cell) in (0_u32..).zip(cells) {}
    for _value in core::iter::repeat(1.0_f64).take(3) {}
    for _value in cells.iter().cycle().take(6) {}
    for (_cell, _weight) in cells.iter().zip(core::iter::repeat(0.5_f64)) {}
}

fn combine(cells: &[f64]) {
    for _value in cells.iter().chain(core::iter::once(&0.5_f64)) {}
    for _state in core::array::from_fn::<[f64; 3], 2, _>(|_| [0.0; 3]) {}
}
