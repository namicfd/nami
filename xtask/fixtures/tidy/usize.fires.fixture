//! `usize` outside the index module: a public signature, a private signature, a field, a public
//! constant and an alias.

pub fn cell_count(cells: usize) -> usize {
    cells
}

fn ghost_count(layers: usize) -> u32 {
    2 * u32::try_from(layers).expect("layer count fits in u32")
}

struct Mesh {
    cells: usize,
}

pub const GHOST_LAYERS: usize = 2;

type Position = usize;
