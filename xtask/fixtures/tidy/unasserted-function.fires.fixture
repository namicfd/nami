// path: crates/solver/src/example.rs
//! Eleven lines of arithmetic on values that nothing checked.

fn kinetic_energy(density: f64, velocity_x: f64, velocity_y: f64, velocity_z: f64) -> f64 {
    let momentum_x = density * velocity_x;
    let momentum_y = density * velocity_y;
    let momentum_z = density * velocity_z;
    let energy_x = 0.5 * momentum_x * velocity_x;
    let energy_y = 0.5 * momentum_y * velocity_y;
    let energy_z = 0.5 * momentum_z * velocity_z;
    let energy_xy = energy_x + energy_y;
    let energy = energy_xy + energy_z;
    energy
}
